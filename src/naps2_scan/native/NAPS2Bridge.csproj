<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX'))">net8.0;net8.0-macos13.0</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('OSX'))">net8.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <AssemblyName>NAPS2Bridge</AssemblyName>
    <RootNamespace>NAPS2Bridge</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAPS2.Sdk" Version="1.3.0" />
    <PackageReference Include="NAPS2.Images.ImageSharp" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <PackageReference Include="NAPS2.Sdk.Worker.Win32" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <PackageReference Include="NAPS2.Sane.Binaries" Version="1.2.2" />
  </ItemGroup>

</Project>
